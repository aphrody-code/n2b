{
    "name": "bun-agent",
    "version": "2.3.1",
    "description": "Bun-native Gemini CLI extension co-located with the n2b migration tool (Rust+TS). 10 agent skills, 7 custom commands, drift hooks (cargo fmt + schema codegen reminders). Mirror of the Claude Code plugin for cross-tool parity.",
    "contextFileName": "GEMINI.md",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "DIR=\"${HOME}/.gemini/data/bun-agent/sessions\" && mkdir -p \"$DIR\" && echo \"{\\\"type\\\":\\\"session_start\\\",\\\"ts\\\":\\\"$(date -Iseconds)\\\",\\\"cwd\\\":\\\"$PWD\\\",\\\"session\\\":\\\"$GEMINI_SESSION_ID\\\"}\" >> \"$DIR/$GEMINI_SESSION_ID.jsonl\"",
                        "timeout": 5,
                        "async": true,
                        "statusMessage": "Initializing bun-agent session"
                    }
                ]
            }
        ],
        "AfterTool": [
            {
                "matcher": "write_file|replace",
                "hooks": [
                    {
                        "type": "command",
                        "command": "DIR=\"${HOME}/.gemini/data/bun-agent/sessions\" && [ -d \"$DIR\" ] && echo \"{\\\"type\\\":\\\"tool_use\\\",\\\"tool\\\":\\\"$(jq -r .tool_name)\\\",\\\"ts\\\":\\\"$(date -Iseconds)\\\"}\" >> \"$DIR/$GEMINI_SESSION_ID.jsonl\" 2>/dev/null",
                        "timeout": 3,
                        "async": true
                    },
                    {
                        "type": "command",
                        "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$file\" in *crates/*.rs|*crates/*/src/*.rs|*crates/*/tests/*.rs) cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" 2>/dev/null && rel=$(realpath --relative-to=. \"$file\") && cargo fmt -- --check \"$rel\" 2>&1 | head -20 && echo 'n2b-hook: cargo fmt drift on '\"$rel\"' — run: cargo fmt --all' >&2 || true ;; esac",
                        "timeout": 8,
                        "async": true,
                        "statusMessage": "n2b: cargo fmt drift check"
                    },
                    {
                        "type": "command",
                        "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$file\" in */schema/v2.json) echo 'n2b-hook: schema/v2.json edited — REMINDER: run `bun run codegen:schema` to propagate to crates/n2b-types/src/schema.rs + packages/n2b-types/src/index.ts. CI green-gate fails on drift.' >&2 ;; esac",
                        "timeout": 3,
                        "async": true,
                        "statusMessage": "n2b: schema codegen reminder"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "exit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "DIR=\"${HOME}/.gemini/data/bun-agent/sessions\" && [ -d \"$DIR\" ] && echo \"{\\\"type\\\":\\\"stop\\\",\\\"ts\\\":\\\"$(date -Iseconds)\\\"}\" >> \"$DIR/$GEMINI_SESSION_ID.jsonl\" 2>/dev/null",
                        "timeout": 3,
                        "async": true
                    }
                ]
            }
        ]
    }
}
