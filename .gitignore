# ─── Build artifacts ────────────────────────────────────────────────
# Rust
target/
**/*.rs.bk
*.pdb

# Node / Bun / TypeScript
node_modules/
dist/
.turbo/
.bun/
.bun-cache/
bun.lockb
packages/*/dist/
packages/*/.turbo/
packages/*/node_modules/

# tsbuildinfo (incremental tsc) — content-addressed, regenerable
*.tsbuildinfo

# ─── Logs & runtime ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Test / coverage artifacts ──────────────────────────────────────
# (n.b. plan/coverage/ is real docs — tracked, do NOT match here)
/coverage/
packages/*/coverage/
crates/*/coverage/
.nyc_output/
lcov.info
*.profraw
*.profdata

# ─── n2b runtime artifacts (target-side state) ──────────────────────
# Created by `n2b --migrate` in repos being migrated; should not leak
# from test fixtures into the n2b repo itself.
.n2b/
.n2b-bak*

# ─── Environment / secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─── Editor / IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.\#*
\#*\#

# ─── OS cruft ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── AI tooling cruft (machine-specific, never project state) ───────
plugins-installed.json
claude-global.md
task.json
GEMINI.md
.gemini/
.aider*
.cursor/
.continue/
.codeium/
# .claude/settings.json IS tracked (project-wide plugin config)
.claude/settings.local.json
.claude/cache/

# ─── Upstream source clones (reference material, regenerable) ───────
upstream/

# ─── Real-world test targets (clones, not n2b's code) ───────────────
# Baselines themselves are tracked under tests/targets/*/baseline.json
tests/targets/gemini-cli/
tests/targets/gemini-cli-out/raw-*.json
