{
	"name": "n2b-monorepo",
	"version": "0.6.1",
	"private": true,
	"description": "n2b monorepo — Bun workspaces + Cargo workspace + Turborepo orchestrateur",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:native": "cargo build --release --workspace",
		"build:native:cli": "cargo build --release -p n2b",
		"build:native:plugin": "cargo build --release -p node2bun-native",
		"build:compile": "turbo run build:compile",
		"install:cli:rust": "cargo build --release -p n2b && sudo install -m755 target/release/n2b /usr/local/bin/n2b",
		"test": "turbo run test",
		"test:rust": "cargo test --workspace",
		"lint": "turbo run lint",
		"lint:fix": "oxlint --fix .",
		"format": "cargo fmt --all",
		"typecheck": "turbo run typecheck",
		"check-self": "bun run --filter @n2b/cli start .",
		"cargo:build": "cargo build --workspace --release",
		"cargo:check": "cargo check --workspace",
		"cargo:test": "cargo test --workspace",
		"cargo:clippy": "cargo clippy --workspace --all-targets",
		"codegen:schema": "bun run scripts/generate-schema-types.ts",
		"codegen:schema:check": "bun run scripts/generate-schema-types.ts --check",
		"baseline:compare": "tests/compare-baseline.sh",
		"baseline": "bash tests/compare-baseline.sh",
		"green-gate:ts": "turbo run typecheck test lint",
		"green-gate:rust": "cargo build --workspace && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check",
		"green-gate": "bunx turbo run '//#green-gate:rust' '//#baseline' '//#codegen:schema:check'",
		"green-gate:serial": "bun run green-gate:rust && bun run baseline && bun run codegen:schema:check",
		"refactor:start": "bash scripts/refactor-start.sh",
		"refactor:attach": "tmux attach -t n2b",
		"refactor:peek": "tmux capture-pane -t n2b -pS -2000 | tail -100",
		"refactor:state": "bash scripts/refactor-state.sh",
		"refactor:status": "tmux has-session -t n2b 2>/dev/null && echo 'n2b: running' || echo 'n2b: not running'",
		"refactor:stop": "tmux send-keys -t n2b C-c",
		"refactor:kill": "tmux kill-session -t n2b 2>/dev/null || true",
		"refactor:restart": "bun run refactor:kill && sleep 1 && bun run refactor:start",
		"refactor:log": "tail -f /tmp/n2b-refactor.log",
		"clean": "rm -rf node_modules/.cache .turbo target packages/*/dist packages/*/node_modules"
	},
	"keywords": [
		"bun",
		"node",
		"migration",
		"codemod",
		"cli",
		"monorepo",
		"turborepo"
	],
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/bun": "latest",
		"oxlint": "^1.63.0",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"packageManager": "bun@1.3.14"
}
