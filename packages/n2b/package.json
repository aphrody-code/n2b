{
  "name": "@n2b/core",
  "version": "0.3.0",
  "description": "TypeScript façade for the `n2b` Rust binary : subprocess wrapper, Bun plugin, and Bun-native shims for the Node patterns n2b flags.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./plugin": "./src/plugin.ts",
    "./ffi": "./src/ffi.ts",
    "./schema": "./src/schema.ts",
    "./shims": "./src/shims/index.ts",
    "./shims/env": "./src/shims/env.ts",
    "./shims/fs": "./src/shims/fs.ts",
    "./shims/path": "./src/shims/path.ts",
    "./shims/shell": "./src/shims/shell.ts"
  },
  "files": ["src"],
  "scripts": {
    "build": "bunx --bun tsc -b",
    "dev": "bun --watch src/index.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun @biomejs/biome check src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false
}
