{
  "name": "@aphrody/n2b-plugin",
  "version": "0.6.2",
  "description": "Plugin Bun (Bun.plugin) + bindings FFI vers libnode2bun_native.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ffi": "./src/ffi.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/n2b-types": "workspace:*",
    "@aphrody/n2b-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
